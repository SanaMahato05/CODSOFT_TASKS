import tkinter as tk
from tkinter import messagebox
import random
import string


class PasswordGeneratorApp(tk.Tk):
    def __init__(self):
        super().__init__()

        self.title("Password Generator [FIX-v3]")
        self.geometry("420x420")
        self.resizable(False, False)

        # --- Custom color palette ---
        self.colors = {
            "bg": "#2f3542",        # charcoal
            "panel": "#3a4050",     # slightly lighter charcoal
            "accent": "#ff6b6b",    # coral
            "accent_dark": "#e85555",
            "text": "#f1f2f6",      # off-white
            "muted": "#a4b0be",     # muted gray-blue
        }
        self.configure(bg=self.colors["bg"])

        # --- State variables ---
        self.length_var = tk.IntVar(value=12)
        self.use_upper = tk.BooleanVar(value=True)
        self.use_lower = tk.BooleanVar(value=True)
        self.use_digits = tk.BooleanVar(value=True)
        self.use_symbols = tk.BooleanVar(value=True)
        self.password_var = tk.StringVar(value="")

        self._build_ui()

    # ------------------------------------------------------------------
    # UI construction
    # ------------------------------------------------------------------
    def _build_ui(self):
        title_label = tk.Label(
            self,
            text="🔐 Password Generator",
            font=("Segoe UI", 18, "bold"),
            bg=self.colors["bg"],
            fg=self.colors["accent"],
        )
        title_label.pack(pady=(20, 10))

        # --- Length selector ---
        length_frame = tk.Frame(self, bg=self.colors["bg"])
        length_frame.pack(pady=10, fill="x", padx=30)

        tk.Label(
            length_frame,
            text="Password Length:",
            font=("Segoe UI", 11),
            bg=self.colors["bg"],
            fg=self.colors["text"],
        ).pack(side="left")

        self.length_display = tk.Label(
            length_frame,
            textvariable=self.length_var,
            font=("Segoe UI", 11, "bold"),
            bg=self.colors["bg"],
            fg=self.colors["accent"],
            width=3,
        )
        self.length_display.pack(side="right")

        length_slider = tk.Scale(
            self,
            from_=4,
            to=64,
            orient="horizontal",
            variable=self.length_var,
            bg=self.colors["bg"],
            fg=self.colors["text"],
            highlightthickness=0,
            troughcolor=self.colors["panel"],
            activebackground=self.colors["accent"],
            showvalue=False,
        )
        length_slider.pack(fill="x", padx=30)

        # --- Complexity options ---
        options_frame = tk.LabelFrame(
            self,
            text="Include Characters",
            font=("Segoe UI", 10, "bold"),
            bg=self.colors["panel"],
            fg=self.colors["text"],
            labelanchor="n",
            bd=2,
            relief="groove",
        )
        options_frame.pack(pady=20, padx=30, fill="x")

        options = [
            ("Uppercase (A-Z)", self.use_upper),
            ("Lowercase (a-z)", self.use_lower),
            ("Digits (0-9)", self.use_digits),
            ("Symbols (!@#$...)", self.use_symbols),
        ]

        for text, var in options:
            cb = tk.Checkbutton(
                options_frame,
                text=text,
                variable=var,
                font=("Segoe UI", 10),
                bg=self.colors["panel"],
                fg=self.colors["text"],
                selectcolor=self.colors["bg"],
                activebackground=self.colors["panel"],
                activeforeground=self.colors["accent"],
                anchor="w",
            )
            cb.pack(fill="x", padx=15, pady=4)

        # --- Generate button ---
        generate_btn = tk.Button(
            self,
            text="Generate Password",
            font=("Segoe UI", 11, "bold"),
            bg=self.colors["accent"],
            fg="white",
            activebackground=self.colors["accent_dark"],
            activeforeground="white",
            relief="flat",
            padx=10,
            pady=8,
            command=self.generate_password,
        )
        generate_btn.pack(pady=10)

        # --- Password display ---
        display_frame = tk.Frame(self, bg=self.colors["bg"])
        display_frame.pack(pady=10, fill="x", padx=30)

        self.password_entry = tk.Entry(
            display_frame,
            textvariable=self.password_var,
            font=("Consolas", 13),
            justify="center",
            bg=self.colors["panel"],
            fg=self.colors["accent"],
            insertbackground=self.colors["text"],
            relief="flat",
            state="readonly",
            readonlybackground=self.colors["panel"],
        )
        self.password_entry.pack(side="left", fill="x", expand=True, ipady=8)

        copy_btn = tk.Button(
            display_frame,
            text="Copy",
            font=("Segoe UI", 9, "bold"),
            bg=self.colors["muted"],
            fg=self.colors["bg"],
            relief="flat",
            command=self.copy_password,
        )
        copy_btn.pack(side="right", padx=(8, 0), ipady=8)

    # ------------------------------------------------------------------
    # Logic
    # ------------------------------------------------------------------
    def generate_password(self):
        length = self.length_var.get()

        # Build the character pool based on selected checkboxes
        pool = ""
        if self.use_upper.get():
            pool += string.ascii_uppercase
        if self.use_lower.get():
            pool += string.ascii_lowercase
        if self.use_digits.get():
            pool += string.digits
        if self.use_symbols.get():
            pool += string.punctuation

        if not pool:
            messagebox.showwarning(
                "No Character Types Selected",
                "Please select at least one character type.",
            )
            return

        # Guarantee at least one character from each selected category
        # so short passwords still respect the chosen complexity.
        required = []
        if self.use_upper.get():
            required.append(random.choice(string.ascii_uppercase))
        if self.use_lower.get():
            required.append(random.choice(string.ascii_lowercase))
        if self.use_digits.get():
            required.append(random.choice(string.digits))
        if self.use_symbols.get():
            required.append(random.choice(string.punctuation))

        if length < len(required):
            messagebox.showwarning(
                "Length Too Short",
                f"Length must be at least {len(required)} to include "
                f"all selected character types.",
            )
            return

        remaining_length = length - len(required)
        random_chars = [random.choice(pool) for _ in range(remaining_length)]

        password_chars = required + random_chars
        random.shuffle(password_chars)  # avoid predictable ordering
        password = "".join(password_chars)

        self.password_var.set(password)

        # Directly refresh the Entry's displayed text. On some systems,
        # a readonly Entry doesn't visually update from the textvariable
        # trace alone, so we update the widget contents explicitly too.
        self.password_entry.config(state="normal")
        self.password_entry.delete(0, tk.END)
        self.password_entry.insert(0, password)
        self.password_entry.config(state="readonly")

    def copy_password(self):
        password = self.password_var.get()
        if not password:
            messagebox.showinfo("Nothing to Copy", "Generate a password first.")
            return
        self.clipboard_clear()
        self.clipboard_append(password)
        messagebox.showinfo("Copied", "Password copied to clipboard!")


if __name__ == "__main__":
    app = PasswordGeneratorApp()
    app.mainloop()
